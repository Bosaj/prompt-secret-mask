{
  "name": "prompt-secret-mask",
  "version": "0.4.0",
  "description": "Keeps API keys, tokens and personal data out of AI prompts: replaces them with placeholders, and restores them in the reply.",
  "author": "Oussama Elhadji <oussousselhadji@gmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "secret-mask": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "web:dev": "vite",
    "web:build": "vite build",
    "fp": "node tools/false-positives.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lucide-react": "^1.54.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
